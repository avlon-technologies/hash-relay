// VALIDATION ONLY — continuum adl/1.7 (ADR-0020) on a throwaway branch.
// Not for merge. States, from the server code, who may invoke three
// commands; claims nothing about enforcement — that is the code's and
// the tests'.
//
// Evidence:
// - DecideApproval, direct: Api/ApprovalEndpoints.cs `/{id}/decision` and
//   Pages/Approval.cshtml.cs — a signed-in account (cookie session +
//   antiforgery) decides as itself.
// - DecideApproval, delegated: `/{id}/device-decision` (PolicyDevice:
//   CredentialKind Device) → DecisionGrants.DecideFromDeviceAsync: an
//   active, unexpired grant for this device credential, AND a Delivery
//   to this device whose NotificationId is the approval's own; the
//   decision is then recorded as the grant's account (g.AccountId).
// - RequestApproval: PolicyRequester (Api credential with publish scope,
//   or Service credential with approvals:create), over REST and over MCP
//   (`request_approval`, `publish_notification` with approval) alike.
// - PublishNotification: PolicyPublish (Api credential, publish scope),
//   REST and MCP alike.
// No MCP route reaches DecideApproval; MCP is a channel (adl/1.7 Phase 2),
// so it is not a sender of its own here.

change AdmitApprovalSenders core adl/1.7 {
  desc "Who may request, publish and decide; a paired device decides only on its person's behalf, with a grant and the approval's own delivery."

  base package Avlon.HashRelay version "draft-1" state "sha256:2f161aaa96b9b7ab3f70227180d64add25627ec2a1dba47835b49708e73f97d9"

  add into #11111111-1111-4111-8111-111111111111 {
    actor PairedDevice #e8c6cd85-b48f-453a-94a4-07c7b8b9a1e6 [system] {
      desc "A desktop or mobile endpoint paired to one person's account, holding a device credential. It may hold a decision grant from that person."
    }
  }

  add into #13131313-1313-4313-8313-131313131313 {
    record NotificationDelivery v1 #e374d88c-f7d1-41ec-a0bb-eaa72646a05f {
      deliveryId: text, endpointRef: text, notificationId: text, tenantId: text
    }
  }

  modify #5bd1be10-b48e-4b77-a7c6-9e57f06d1008 attributes.admissions = [#42424242-4242-4242-8242-424242424242; #e8c6cd85-b48f-453a-94a4-07c7b8b9a1e6 on-behalf-of #42424242-4242-4242-8242-424242424242 requires #a35ab5c0-579f-48b6-b27a-81b2ea764d4f, #e374d88c-f7d1-41ec-a0bb-eaa72646a05f for approvalId]
    hint "The person decides on the page; their paired device decides for them only with an active grant and the approval's own delivery."

  modify #5bd1be10-b48e-4b77-a7c6-9e57f06d1007 attributes.admissions = [#22222222-2222-4222-8222-222222222222]
    hint "Only a publishing credential may ask for an approval."

  modify #eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee attributes.admissions = [#22222222-2222-4222-8222-222222222222]
    hint "Only a publishing credential may publish."
}
