// Mobile apps (roadmap M3): a first-party iOS/Android subscriber app and the push transport
// that reaches it. Authored against the Windows-first draft-1 state; a proposal until approved.
//
// Product decision (Mike, 2026-10-31): mobile push goes through Firebase Cloud Messaging for
// BOTH platforms. Firebase relays iOS messages to Apple Push with the APNs key uploaded to the
// Firebase project, so the cloud talks to one provider and holds one kind of token.
//
// What this change deliberately does NOT claim: no mobile SDK for third-party apps, no new
// bounded context, no new message (push-token registration is RegisterEndpoint with the
// providerToken the model already carries), no technology beyond the provider (Expo, FCM HTTP v1
// are binding concerns).

change IntroduceMobileApp core adl/1.4 {
  desc "Subscribers can receive hashtag notifications on iOS and Android through a first-party app; delivery fans out through Firebase Cloud Messaging for mobile endpoints and records provider acceptance separately from display."

  base package Avlon.HashRelay version "draft-1" state "sha256:ab23b1eb090ee3813800d18fd10b09a8436e51890c27610c873faa85520531e7"

  // 1. The new client, beside DesktopAgent. Like DesktopAgent it hosts no modelled service:
  //    it is the subscriber-side endpoint, not part of the cloud.
  add into #11111111-1111-4111-8111-111111111111 {
    deployable MobileApp #016836e1-a201-4cfd-9e8b-3c114c612ee3 {
      desc "First-party HashRelay app for iOS and Android. Pairs as a subscriber endpoint, registers its Firebase push token, manages its subscriptions and shows notifications: by push when backgrounded, live over the realtime transport while in the foreground."
    }
  }

  // 2. Delivery now depends on Firebase Cloud Messaging, which the model already declared as an
  //    external system but never wired. Apple Push stays declared: it is reached through Firebase,
  //    not by the cloud itself, and its description now says so.
  link #18181818-1818-4818-8818-181818181818 dependsOn #55555555-5555-4555-8555-555555555555
    hint "Every mobile endpoint holding a provider token is reached through Firebase Cloud Messaging, on Android and on iOS."

  modify #55555555-5555-4555-8555-555555555555 description = "Firebase Cloud Messaging: the single push provider for mobile endpoints. Delivers to Android directly and relays iOS messages to Apple Push with the project's APNs key."
  modify #44444444-4444-4444-8444-444444444444 description = "Apple Push Notification service for iOS push delivery, reached indirectly through Firebase Cloud Messaging; HashRelay holds no APNs connection of its own."

  modify #18181818-1818-4818-8818-181818181818 description = "Fans out accepted notifications to eligible endpoint transports: the realtime connection for connected agents and foreground apps, Firebase Cloud Messaging for mobile endpoints holding a provider token. Transport selection is an implementation binding."

  // 3. The vision principle that becomes operational once push exists: a provider saying
  //    "accepted" is not the phone showing anything. Recorded as a requirement Delivery satisfies.
  add into #88888888-8888-4888-8888-888888888888 {
    requirement DeliveryEvidence #4b83047e-c625-485c-8330-1a6a171bd029 {
      desc "Provider acceptance of a push is recorded as provider acceptance and never reported as display or user acknowledgement; display is known only when the endpoint acknowledges the delivery."
    }
  }
  link #18181818-1818-4818-8818-181818181818 satisfies #4b83047e-c625-485c-8330-1a6a171bd029

  // 4. EndpointService already registers "mobile push tokens" by its own description; make the
  //    registration say what a provider token is for.
  modify #17171717-1717-4717-8717-171717171717 description = "Registers desktop agents and mobile apps as endpoints. A mobile registration carries the Firebase push token (providerToken) and is re-sent whenever the platform rotates it."
}
