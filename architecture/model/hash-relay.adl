document semantic at :: {

system HashRelay #11111111-1111-4111-8111-111111111111 {
  desc "Cross-platform hashtag-addressed notification routing and delivery for desktop agents, mobile apps, application SDKs, and AI clients."

  actor AccountHolder #42424242-4242-4242-8242-424242424242 [person] {
    desc "A signed-up user who can administer one or more tenant workspaces through a dashboard."
  }
  actor Publisher #22222222-2222-4222-8222-222222222222 [system] {
    desc "An authorized credential holder publishing notifications: an application, a service, an AI agent or a person at a paired device. Its type is declared at registration and is otherwise unknown; nothing about the transport decides it."
  }
  actor Subscriber #33333333-3333-4333-8333-333333333333 [person] {
    desc "A person receiving notifications through registered endpoints."
  }
  deployable CloudApi #19191919-1919-4919-8919-191919191919 {
    desc "Initial single cloud process hosting API, routing, endpoint registration, and delivery dispatch."
  }
  deployable DesktopAgent #20202020-2020-4020-8020-202020202020 {
    desc "Installable user-session client displaying native notifications."
  }
  deployable MobileApp #016836e1-a201-4cfd-9e8b-3c114c612ee3 {
    desc "First-party HashRelay app for iOS and Android. Pairs as a subscriber endpoint, registers its Firebase push token, manages its subscriptions and shows notifications: by push when backgrounded, live over the realtime transport while in the foreground."
  }
  domain Access #30303030-3030-4030-8030-303030303030 {
    classification = supporting

    bounded-context TenantIdentity #33333334-3333-4333-8333-333333333334 {
      realizes: ::HashRelay.Access.TenantAdministration

      command CreateTenant #36363636-3636-4636-8636-363636363636 {
        payload = ::HashRelay.Access.TenantIdentity.TenantRegistration
      }
      command IssueApiKey #37373737-3737-4737-8737-373737373737 {
        payload = ::HashRelay.Access.TenantIdentity.KeyIssueRequest
      }
      resource ApiKeyRegistry #39393939-3939-4939-8939-393939393939 [data-store] {
        persistence[durable; strong; retention="key lifecycle and audit policy"]
      }
      resource TenantRegistry #38383838-3838-4838-8838-383838383838 [data-store] {
        persistence[durable; strong; retention="tenant and membership lifecycle"]
      }
      service ApiKeyService #41414141-4141-4141-8141-414141414141 {
        desc "Issues tenant-bound API key identities, retains verifiers rather than plaintext secrets, and supports lifecycle operations to be specified."
        handles: ::HashRelay.Access.TenantIdentity.IssueApiKey
        reads: ::HashRelay.Access.TenantIdentity.TenantRegistry
        realizes: ::HashRelay.Access.TenantAdministration
        satisfies: ::HashRelay.Access.TenantAdministration.TenantKeyIsolation
        writes: ::HashRelay.Access.TenantIdentity.ApiKeyRegistry

        api KeysApi #53535353-5353-4353-8353-535353535353 {
          operation Issue #54545454-5454-4454-8454-545454545454 {
            in = ::HashRelay.Access.TenantIdentity.KeyIssueRequest
            out = ::HashRelay.Access.TenantIdentity.KeyIssueRequest
          }
        }
      }
      service TenantAdministrationService #40404040-4040-4040-8040-404040404040 {
        desc "Creates tenants and records their owners and members. Dashboard and user authentication integration are still to be specified."
        handles: ::HashRelay.Access.TenantIdentity.CreateTenant
        realizes: ::HashRelay.Access.TenantAdministration
        writes: ::HashRelay.Access.TenantIdentity.TenantRegistry
      }
      record KeyIssueRequest v1 #35353535-3535-4535-8535-353535353535 { label: text, requestedByUserId: text, tenantId: text }
      record TenantRegistration v1 #34343434-3434-4434-8434-343434343434 { displayName: text, ownerUserId: text, tenantId: text }
    }
    capability TenantAdministration #31313131-3131-4131-8131-313131313131 {
      desc "Users create tenant workspaces, manage membership and issue tenant-scoped API keys via a dashboard."

      requirement TenantKeyIsolation #32323232-3232-4232-8232-323232323232 {
        desc "An API credential resolves to exactly one tenant and cannot access another tenant's data."
      }
    }
  }
  domain Approvals #5bd1be10-b48e-4b77-a7c6-9e57f06d1001 {
    classification = supporting

    bounded-context DecisionManagement #5bd1be10-b48e-4b77-a7c6-9e57f06d1004 {
      realizes: ::HashRelay.Approvals.HumanDecision

      command CancelApproval #2a04c1b4-04f1-480e-9ea2-4396bebf6976 {
        payload = ::HashRelay.Approvals.DecisionManagement.ApprovalReference
      }
      command DecideApproval #5bd1be10-b48e-4b77-a7c6-9e57f06d1008 {
        payload = ::HashRelay.Approvals.DecisionManagement.ApprovalDecision
        admits ::HashRelay.AccountHolder
        admits ::HashRelay.PairedDevice on-behalf-of ::HashRelay.AccountHolder requires ::HashRelay.Approvals.DecisionManagement.DecisionGrant, ::HashRelay.Notifications.Delivery.EndpointDelivery for approvalId
      }
      command GrantDeviceDecisions #bef797ed-e6ea-4be9-b11f-25de3ff9f24e {
        payload = ::HashRelay.Approvals.DecisionManagement.DecisionGrant
      }
      command RequestApproval #5bd1be10-b48e-4b77-a7c6-9e57f06d1007 {
        payload = ::HashRelay.Approvals.DecisionManagement.ApprovalRequest
        admits ::HashRelay.ApprovalRequester
      }
      command RevokeDeviceDecisions #629a27a5-b5d9-4095-809d-d9623906ad77 {
        payload = ::HashRelay.Approvals.DecisionManagement.DecisionGrant
      }
      event ApprovalResolved #5bd1be10-b48e-4b77-a7c6-9e57f06d1009 {
        payload = ::HashRelay.Approvals.DecisionManagement.ApprovalOutcome
      }
      resource ApprovalStore #5bd1be10-b48e-4b77-a7c6-9e57f06d1010 [data-store] {
        persistence[durable; strong; retention="approval lifecycle and audit policy"]
      }
      resource DecisionGrantStore #cad19393-5a26-44be-8f35-02f4e3960ef4 [data-store] {
        persistence[durable; strong; retention="grant lifecycle and audit policy"]
      }
      service ApprovalOutcomeReader #5bd1be10-b48e-4b77-a7c6-9e57f06d1015 {
        desc "Reacts to resolved approvals to make durable completion available to originating systems through authenticated retrieval. No workflow execution in HashRelay."
        reads: ::HashRelay.Approvals.DecisionManagement.ApprovalStore
        subscribesTo: ::HashRelay.Approvals.DecisionManagement.ApprovalResolved
      }
      service ApprovalService #5bd1be10-b48e-4b77-a7c6-9e57f06d1011 {
        desc "Creates and atomically resolves authorized approvals; publishes committed decisions for requesting applications to observe. Does not execute approved operations."
        dependsOn: ::HashRelay.Notifications.Routing.RoutingService, ::HashRelay.Access.TenantIdentity.TenantAdministrationService
        handles: ::HashRelay.Approvals.DecisionManagement.CancelApproval, ::HashRelay.Approvals.DecisionManagement.RequestApproval, ::HashRelay.Approvals.DecisionManagement.DecideApproval, ::HashRelay.Approvals.DecisionManagement.RevokeDeviceDecisions, ::HashRelay.Approvals.DecisionManagement.GrantDeviceDecisions
        publishes: ::HashRelay.Approvals.DecisionManagement.ApprovalResolved
        reads: ::HashRelay.Approvals.DecisionManagement.ApprovalStore, ::HashRelay.Approvals.DecisionManagement.DecisionGrantStore
        realizes: ::HashRelay.Approvals.HumanDecision
        satisfies: ::HashRelay.Approvals.HumanDecision.DecisionIntegrity, ::HashRelay.Approvals.HumanDecision.OutcomeLifecycle, ::HashRelay.Approvals.HumanDecision.DeviceDecisionAuthority
        writes: ::HashRelay.Approvals.DecisionManagement.ApprovalStore, ::HashRelay.Approvals.DecisionManagement.DecisionGrantStore

        api ApprovalApi #5bd1be10-b48e-4b77-a7c6-9e57f06d1012 {
          operation Cancel #8fe3c0da-4c06-4f72-9904-cd7d0f2a93df {
            in = ::HashRelay.Approvals.DecisionManagement.ApprovalReference
            out = ::HashRelay.Approvals.DecisionManagement.ApprovalOutcome
          }
          operation Decide #5bd1be10-b48e-4b77-a7c6-9e57f06d1014 {
            in = ::HashRelay.Approvals.DecisionManagement.ApprovalDecision
            out = ::HashRelay.Approvals.DecisionManagement.ApprovalDecision
          }
          operation EnrollDevice #a5bfefc3-4121-4e7f-9ab6-a74ec33746bb {
            in = ::HashRelay.Approvals.DecisionManagement.DecisionGrant
            out = ::HashRelay.Approvals.DecisionManagement.DecisionGrant
          }
          operation Request #5bd1be10-b48e-4b77-a7c6-9e57f06d1013 {
            in = ::HashRelay.Approvals.DecisionManagement.ApprovalRequest
            out = ::HashRelay.Approvals.DecisionManagement.ApprovalRequest
          }
          operation Retrieve #c288ed53-834c-46dc-9e69-b7f63e39b0c1 {
            in = ::HashRelay.Approvals.DecisionManagement.ApprovalReference
            out = ::HashRelay.Approvals.DecisionManagement.ApprovalOutcome
          }
          operation RevokeDevice #46ebc799-6c9b-4dc4-b381-af1d467edf8c {
            in = ::HashRelay.Approvals.DecisionManagement.DecisionGrant
            out = ::HashRelay.Approvals.DecisionManagement.DecisionGrant
          }
        }
      }
      record ApprovalDecision v1 #5bd1be10-b48e-4b77-a7c6-9e57f06d1006 { approvalId: text, decidedAt: text, decidedBy: text, decision: text }
      record ApprovalOutcome v1 #eb38d58f-e819-4079-b582-56995ccdb1c7 { approvalId: text, cause: text, correlationId: optional(text), decidedBy: optional(text), requesterId: text, resolvedAt: text, status: text, version: text, workspaceId: text }
      record ApprovalReference v1 #c85d210f-16fe-4db6-8a70-a3c116548d85 { approvalId: text, requesterId: text, workspaceId: text }
      record ApprovalRequest v1 #5bd1be10-b48e-4b77-a7c6-9e57f06d1005 { approvalId: text, expiresAt: text, requesterId: text, subject: text, workspaceId: text }
      record DecisionGrant v1 #a35ab5c0-579f-48b6-b27a-81b2ea764d4f { accountId: text, deviceCredentialId: text, expiresAt: text, grantId: text, status: text, workspaceId: text }
    }
    capability HumanDecision #5bd1be10-b48e-4b77-a7c6-9e57f06d1002 {
      desc "Authorized users decide time-bound requests; requesting systems remain responsible for executing approved operations."

      requirement DecisionIntegrity #5bd1be10-b48e-4b77-a7c6-9e57f06d1003 {
        desc "A decision is tenant-isolated, authorized against the designated approvers, committed at most once from Pending, and durably retrievable by the requester."
      }
      requirement DeviceDecisionAuthority #f8c9062d-d840-4c17-bb33-c6994f644ca4 {
        desc "A device may submit DecideApproval only together with an active decision grant that the person it names gave explicitly, after interactive sign-in, to that paired device's credential in that workspace, and only that person may grant it. The pairing token alone never decides, and a device decides only from the approval's own notification as delivered to that device. At decision time the grant must be unrevoked and unexpired, its device credential still active, the approval in the grant's workspace, and the person still a member and a designated approver. Grants are revocable by the person and by the device."
      }
      requirement OutcomeLifecycle #d8f8d42f-f7c1-4d35-b9e2-ab5d4d760c64 {
        desc "An approval is created Pending and leaves Pending exactly once, to Approved or Rejected by a designated human's decision made while the server time is before expiresAt, to Expired when that time is reached, or to Cancelled by its requester. Terminal outcomes are immutable. The resolved event names its cause and names a decider only when a human decided."
      }
    }
  }
  domain Notifications #77777777-7777-4777-8777-777777777777 {
    classification = core

    bounded-context Delivery #13131313-1313-4313-8313-131313131313 {
      realizes: ::HashRelay.Notifications.HashtagDelivery

      command RegisterEndpoint #15151515-1515-4515-8515-151515151515 {
        payload = ::HashRelay.Notifications.Delivery.EndpointRegistration
      }
      resource EndpointStore #16161616-1616-4616-8616-161616161616 [data-store] {
        persistence[durable; strong; retention="endpoint lifecycle"]
      }
      service DeliveryService #18181818-1818-4818-8818-181818181818 {
        desc "Fans out accepted notifications to eligible endpoint transports: the realtime connection for connected agents and foreground apps, Firebase Cloud Messaging for mobile endpoints holding a provider token. Replays unacknowledged deliveries to a reconnecting endpoint, flagged as replayed and bounded in attempts. Transport selection is an implementation binding."
        dependsOn: ::HashRelay.FirebaseMessaging
        reads: ::HashRelay.Notifications.Delivery.EndpointStore
        satisfies: ::HashRelay.Notifications.HashtagDelivery.DeliveryEvidence, ::HashRelay.Notifications.HashtagDelivery.OncePerEndpoint, ::HashRelay.Notifications.HashtagDelivery.CatchUpWithoutInterruption
        subscribesTo: ::HashRelay.Notifications.Routing.NotificationAccepted
      }
      service EndpointService #17171717-1717-4717-8717-171717171717 {
        desc "Registers desktop agents and mobile apps as endpoints. A mobile registration carries the Firebase push token (providerToken) and is re-sent whenever the platform rotates it."
        handles: ::HashRelay.Notifications.Delivery.RegisterEndpoint
        writes: ::HashRelay.Notifications.Delivery.EndpointStore

        api EndpointApi #55555556-5555-4555-8555-555555555556 {
          operation Register #56565656-5656-4656-8656-565656565656 {
            in = ::HashRelay.Notifications.Delivery.EndpointRegistration
            out = ::HashRelay.Notifications.Delivery.EndpointRegistration
          }
        }
      }
      record EndpointRegistration v1 #14141414-1414-4414-8414-141414141414 { endpointId: text, platform: text, providerToken: optional(text), subscriberId: text, workspaceId: text }
      record EndpointDelivery v1 #93717198-6a4c-490d-aaf7-ec34216f9b58 { deliveryId: text, workspaceId: text, notificationId: text, endpointId: text, status: text }
    }
    bounded-context Routing #bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb {
      realizes: ::HashRelay.Notifications.HashtagDelivery

      command PublishNotification #eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee {
        occurrence-identity = payload.notificationId
        payload = ::HashRelay.Notifications.Routing.Publication
        admits ::HashRelay.Publisher
        admits ::HashRelay.Approvals.DecisionManagement.ApprovalService
      }
      command SubscribeTag #ffffffff-ffff-4fff-8fff-ffffffffffff {
        payload = ::HashRelay.Notifications.Routing.SubscriptionChange
      }
      event NotificationAccepted #10101010-1010-4010-8010-101010101010 {
        payload = ::HashRelay.Notifications.Routing.Publication
      }
      resource RoutingStore #11111112-1111-4111-8111-111111111112 [data-store] {
        persistence[durable; strong; retention="notification and subscription policy"]
      }
      service RoutingService #12121212-1212-4212-8212-121212121212 {
        desc "Authorizes publications and subscriptions, owns hashtag matching and stamps each accepted notification with the attribution of the credential that published it."
        handles: ::HashRelay.Notifications.Routing.PublishNotification, ::HashRelay.Notifications.Routing.SubscribeTag
        publishes: ::HashRelay.Notifications.Routing.NotificationAccepted
        reads: ::HashRelay.Notifications.Routing.RoutingStore
        realizes: ::HashRelay.Notifications.HashtagDelivery
        satisfies: ::HashRelay.Notifications.HashtagDelivery.ForwardOnlySubscription, ::HashRelay.Notifications.HashtagDelivery.WorkspaceIsolation, ::HashRelay.Notifications.HashtagDelivery.PublisherAttribution
        writes: ::HashRelay.Notifications.Routing.RoutingStore

        api PublicationApi #50505050-5050-4050-8050-505050505050 {
          operation Publish #51515151-5151-4151-8151-515151515151 {
            in = ::HashRelay.Notifications.Routing.Publication
            out = ::HashRelay.Notifications.Routing.Publication
          }
          operation Subscribe #52525252-5252-4252-8252-525252525252 {
            in = ::HashRelay.Notifications.Routing.SubscriptionChange
            out = ::HashRelay.Notifications.Routing.SubscriptionChange
          }
        }
      }
      record Publication v1 #cccccccc-cccc-4ccc-8ccc-cccccccccccc { body: text, notificationId: text, tags: list(text), title: text, workspaceId: text }
      record SubscriptionChange v1 #dddddddd-dddd-4ddd-8ddd-dddddddddddd { subscriberId: text, tag: text, workspaceId: text }
    }
    capability HashtagDelivery #88888888-8888-4888-8888-888888888888 {
      desc "An authorized publisher addresses one or more hashtags and subscribed endpoints receive matching notifications."

      requirement CatchUpWithoutInterruption #fb42409f-e5a7-42f9-bb02-ffa24e4fd1eb {
        desc "Deliveries that accumulate while an endpoint is away are replayed on reconnect, flagged as replayed and retained until acknowledged, so the endpoint can record them without presenting each one; live deliveries are presented at once. Acknowledgement means received, not shown."
      }
      requirement DeliveryEvidence #4b83047e-c625-485c-8330-1a6a171bd029 {
        desc "Provider acceptance of a push is recorded as provider acceptance and never reported as display or user acknowledgement; display is known only when the endpoint acknowledges the delivery."
      }
      requirement ForwardOnlySubscription #49ca33cb-df60-4ef4-9280-7807328ea2d5 {
        desc "A subscription applies to notifications published after it exists. Earlier notifications are never replayed into a new subscription; they remain readable through the workspace's history."
      }
      requirement OncePerEndpoint #aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa {
        desc "A notification matching multiple tags is logically delivered at most once per endpoint, with idempotent processing."
      }
      requirement PublisherAttribution #abb41875-38c1-4a85-a377-293012ad4b3d {
        desc "Every notification records who published it: a stable publisher id, a display name, a publisher type (agent, application, service, human or unknown) and the entry channel. All four are established by the routing service from the authenticated credential and its registration; none is taken from the message body or inferred from the transport. A type that was never declared is unknown."
      }
      requirement WorkspaceIsolation #99999999-9999-4999-8999-999999999999 {
        desc "Subscriptions, publishers and notifications are isolated by workspace."
      }
    }
  }
  environment LocalDevelopment #21212121-2121-4121-8121-212121212121
  external-system ApplePush #44444444-4444-4444-8444-444444444444 {
    desc "Apple Push Notification service for iOS push delivery, reached indirectly through Firebase Cloud Messaging; HashRelay holds no APNs connection of its own."
  }
  external-system DesktopNotificationCenter #66666666-6666-4666-8666-666666666666 {
    desc "Native Windows, macOS, and Linux user-session notification facilities."
  }
  external-system FirebaseMessaging #55555555-5555-4555-8555-555555555555 {
    desc "Firebase Cloud Messaging: the single push provider for mobile endpoints. Delivers to Android directly and relays iOS messages to Apple Push with the project's APNs key."
  }
  actor ApprovalRequester #6a2388c1-6df9-43a4-80b7-85f9371c639b [system] {
    desc "An application credential admitted to request approvals: an API key holding the publish scope, or a service-account key (an OAuth access token issued to a connector is one) whose service account holds approvals:create. A paired device token and a person's session are never one."
  }
  actor PairedDevice #80adbab6-b940-4812-af9c-1f161daf55e2 [system] {
    desc "The holder of a paired device token: a device credential bound to one endpoint in one workspace, issued when a signed-in person approves a pairing request."
  }
}
}
