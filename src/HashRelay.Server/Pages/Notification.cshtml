@page "/n/{id:guid}"
@model HashRelay.Server.Pages.NotificationModel
@{
    ViewData["Title"] = Model.Item.Title;
    var n = Model.Item;
}
<section class="section">
    <div class="container narrow">
        <nav class="crumbs"><a href="/dashboard/activity">Activity</a> <span>/</span> <span>@Model.TenantName</span></nav>
        <article class="card notification">
            <div class="card-body">
                <div class="notification-meta">
                    <div class="tags">@foreach (var t in n.Tags) { <span class="tag">#@t</span> }</div>
                    <div class="muted small">
                        <time data-rel datetime="@n.PublishedAt.ToString("o")">@n.PublishedAt.ToString("g")</time>
                        · @Model.Delivered/@n.MatchedEndpoints delivered
                        @if (n.Priority != "normal") { <span class="badge badge-accent">@n.Priority</span> }
                    </div>
                </div>
                <h1 class="notification-title">@n.Title</h1>
                @if (!string.IsNullOrEmpty(n.Body) && n.Markdown is null)
                {
                    <p class="lead">@n.Body</p>
                }
                @if (Model.MarkdownHtml is not null)
                {
                    <div class="md">@Html.Raw(Model.MarkdownHtml)</div>
                }
                @if (n.Diagram is not null && (n.Markdown is null || !n.Markdown.Contains(n.Diagram)))
                {
                    <div class="diagram"><pre class="mermaid">@n.Diagram</pre></div>
                }
                @if (Model.ShowImage)
                {
                    <figure class="notification-image"><img src="@n.ImageUrl" alt="" loading="lazy" /></figure>
                }
                @if (!string.IsNullOrEmpty(n.Url))
                {
                    <p class="mt-3"><a class="btn btn-primary" href="@n.Url" target="_blank" rel="noopener">Open link ↗</a> <span class="muted small">@n.Url</span></p>
                }
            </div>
        </article>
        @if (n.Diagram is not null && n.DiagramImageUrl is not null)
        {
            <p class="muted small mt-2">Toast image: <a href="@n.DiagramImageUrl" target="_blank" rel="noopener">rendered PNG</a></p>
        }
    </div>
</section>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.min.js"></script>
    <script>
      (function () {
        // ```mermaid fences from markdown arrive as <pre><code class="language-mermaid">; hand them to mermaid.
        document.querySelectorAll("pre > code.language-mermaid").forEach((code) => {
          const pre = code.parentElement;
          const holder = document.createElement("div");
          holder.className = "diagram";
          const m = document.createElement("pre");
          m.className = "mermaid";
          m.textContent = code.textContent;
          holder.appendChild(m);
          pre.replaceWith(holder);
        });
        const dark = document.documentElement.dataset.theme === "dark" ||
          (document.documentElement.dataset.theme !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        mermaid.initialize({ startOnLoad: false, securityLevel: "strict", theme: dark ? "dark" : "default", fontFamily: "Inter, system-ui, sans-serif" });
        // Mermaid sizes nodes by measuring text, so wait for the web font or labels get clipped.
        const ready = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
        ready.then(() => mermaid.run({ querySelector: ".mermaid" })).catch((e) => console.warn("mermaid", e));
      })();
    </script>
}
