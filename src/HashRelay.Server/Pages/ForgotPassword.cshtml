@page "/forgot-password"
@model HashRelay.Server.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="auth">
    <div class="card">
        <div class="card-body">
            <div class="brand-mark" aria-hidden="true">#</div>
            @if (Model.Sent)
            {
                <h1>Check your email</h1>
                <p class="sub">If an account exists for <strong>@Model.Input.Email</strong>, we have sent a link to reset its password. The link works once and expires in @Model.LifetimeHours hour@(Model.LifetimeHours == 1 ? "" : "s").</p>
                <p class="small muted">No email after a few minutes? Check your spam folder, or <a href="/forgot-password">request another link</a>.</p>
                <p class="alt"><a href="/login">Back to sign in</a></p>
            }
            else
            {
                <h1>Forgot your password?</h1>
                <p class="sub">Enter the email you signed up with and we will send you a link to choose a new one.</p>
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="field">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="input" type="email" autocomplete="email" autofocus />
                        <span asp-validation-for="Input.Email" class="error-text"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block btn-lg">Send reset link</button>
                </form>
                <p class="alt">Remembered it? <a href="/login">Sign in</a></p>
            }
        </div>
    </div>
</div>
