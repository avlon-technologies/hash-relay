@page "/reset-password"
@model HashRelay.Server.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}
<div class="auth">
    <div class="card">
        <div class="card-body">
            <div class="brand-mark" aria-hidden="true">#</div>
            @if (!Model.TokenValid)
            {
                <h1>This link has expired</h1>
                <p class="sub">Reset links work once and expire after @Model.LifetimeHours hour@(Model.LifetimeHours == 1 ? "" : "s"). Request a new one and use the most recent email.</p>
                <a href="/forgot-password" class="btn btn-primary btn-block btn-lg">Request a new link</a>
                <p class="alt"><a href="/login">Back to sign in</a></p>
            }
            else
            {
                <h1>Choose a new password</h1>
                <p class="sub">for <strong>@Model.Email</strong></p>
                <form method="post" novalidate>
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="field">
                        <label asp-for="Input.Password">New password</label>
                        <input asp-for="Input.Password" class="input" type="password" autocomplete="new-password" minlength="@AccountService.MinPasswordLength" autofocus />
                        <p class="hint">At least @AccountService.MinPasswordLength characters.</p>
                        <span asp-validation-for="Input.Password" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Confirm">Confirm new password</label>
                        <input asp-for="Input.Confirm" class="input" type="password" autocomplete="new-password" minlength="@AccountService.MinPasswordLength" />
                        <span asp-validation-for="Input.Confirm" class="error-text"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block btn-lg">Set new password</button>
                </form>
            }
        </div>
    </div>
</div>
