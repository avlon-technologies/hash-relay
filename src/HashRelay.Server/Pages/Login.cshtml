@page
@model HashRelay.Server.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth">
    <div class="card">
        <div class="card-body">
            <div class="brand-mark" aria-hidden="true">#</div>
            <h1>Welcome back</h1>
            <p class="sub">Sign in to manage keys, devices and activity.</p>
            <form method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="field">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="input" type="email" autocomplete="email" autofocus />
                    <span asp-validation-for="Input.Email" class="error-text"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" class="input" type="password" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="error-text"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-block btn-lg">Sign in</button>
                <p class="alt" style="margin-top:12px"><a href="/forgot-password">Forgot your password?</a></p>
            </form>
            <p class="alt">New here? <a href="/signup">Create a workspace</a></p>
        </div>
    </div>
</div>
