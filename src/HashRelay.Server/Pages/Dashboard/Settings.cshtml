@page "/dashboard/settings"
@model HashRelay.Server.Pages.Dashboard.SettingsModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Settings";
}
<div class="page-head">
    <div>
        <h1>Settings</h1>
        <p>Workspace and account.</p>
    </div>
</div>
<partial name="_Flash" />
@if (Model.NoWorkspace)
{
    <div class="alert alert-warn">Your account has no workspace yet. Create one below.</div>
}

@if (Model.HasTenant)
{
    <div class="card">
        <div class="card-header"><h3>Workspace</h3></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Rename" class="form-row two">
                <div class="field mb-0">
                    <label for="name">Name</label>
                    <input class="input" id="name" name="name" value="@Model.TenantName" maxlength="80" required @(Model.CanManage ? "" : "disabled") />
                </div>
                <div class="field mb-0">
                    <label>Slug</label>
                    <div class="input mono muted" style="display:flex;align-items:center">@Model.Slug</div>
                </div>
                @if (Model.CanManage) { <div><button class="btn" type="submit">Save</button></div> }
            </form>
            <hr />
            <div class="small muted">Workspace id <span class="mono">@Model.TenantId</span> · your role: <span class="badge badge-accent">@Model.Role</span></div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header"><h3>Create another workspace</h3></div>
    <div class="card-body">
        <p class="small">Workspaces isolate hashtags, keys and devices. Use one per team or environment.</p>
        <form method="post" asp-page-handler="Create" class="input-group" style="max-width:520px">
            <input class="input" name="name" placeholder="Acme Staging" maxlength="80" required />
            <button class="btn btn-primary" type="submit">Create</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3>Account</h3></div>
    <div class="card-body">
        <div class="grid grid-2">
            <div><div class="code-title">Name</div><div>@Model.AccountName</div></div>
            <div><div class="code-title">Email</div><div>@Model.AccountEmail</div></div>
        </div>
        <hr />
        <form method="post" asp-page-handler="Password" class="form-row three" autocomplete="off">
            <div class="field mb-0">
                <label for="currentPassword">Current password</label>
                <input class="input" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />
            </div>
            <div class="field mb-0">
                <label for="newPassword">New password</label>
                <input class="input" id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="@AccountService.MinPasswordLength" required />
            </div>
            <div class="field mb-0">
                <label for="confirmPassword">Confirm new password</label>
                <input class="input" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="@AccountService.MinPasswordLength" required />
            </div>
            <div><button class="btn" type="submit">Change password</button></div>
        </form>
        <p class="small muted" style="margin-top:8px">At least @AccountService.MinPasswordLength characters. Changing it does not sign out other sessions.</p>
        <hr />
        <form method="post" asp-page="/Logout"><button class="btn" type="submit">Sign out</button></form>
    </div>
</div>
