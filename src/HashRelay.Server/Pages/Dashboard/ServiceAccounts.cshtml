@page "/dashboard/service-accounts"
@using HashRelay.Contracts
@model HashRelay.Server.Pages.Dashboard.ServiceAccountsModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Service accounts";
}
<div class="page-head">
    <div>
        <h1>Service accounts</h1>
        <p>Credentials for AI agents and automations that publish to <strong>@Model.TenantName</strong> over MCP or the REST API. Each account has its own permissions, allowed hashtags, quota and audit trail.</p>
    </div>
    <div class="page-actions">
        @if (Model.CanManage)
        {
            <button class="btn btn-primary" data-open="#create-sa">New service account</button>
        }
    </div>
</div>
<partial name="_Flash" />

<div class="card">
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Name</th><th>Permissions</th><th>Allowed hashtags</th><th>Keys</th><th>Last used</th><th>Status</th><th class="actions"></th></tr></thead>
            <tbody>
                @if (Model.Accounts.Count == 0)
                {
                    <tr><td colspan="7"><div class="empty">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4M8 16h.01M12 16h.01M16 16h.01"/></svg>
                        <h3>No service accounts yet</h3><p>Create one to let Claude Code, Cursor or your own agents publish notifications through <code>@Model.McpUrl</code>.</p>
                        @if (Model.CanManage) { <button class="btn btn-primary" data-open="#create-sa">Create your first service account</button> }
                    </div></td></tr>
                }
                @foreach (var row in Model.Accounts)
                {
                    var a = row.Account;
                    <tr>
                        <td class="nowrap"><a href="/dashboard/service-accounts/@a.Id"><strong>@a.Name</strong></a><div class="small muted desc">@PublisherTypes.Labels[PublisherTypes.Normalize(a.PublisherType)]@(string.IsNullOrEmpty(a.Description) ? "" : $" · {a.Description}")</div></td>
                        <td><div class="tags">@foreach (var s in a.ScopeList) { <span class="badge badge-accent">@s</span> }</div></td>
                        <td class="mono small">@string.Join(" ", a.AllowedTagList.Select(t => "#" + t))</td>
                        <td>@row.ActiveKeys</td>
                        <td>@if (a.LastUsedAt is null) { <span class="muted">never</span> } else { <time data-rel datetime="@a.LastUsedAt.Value.ToString("o")">@a.LastUsedAt.Value.ToString("g")</time> }</td>
                        <td>@if (a.Enabled) { <span class="badge badge-success"><span class="dot"></span>Enabled</span> } else { <span class="badge badge-danger">Disabled</span> }</td>
                        <td class="actions"><a class="btn btn-sm" href="/dashboard/service-accounts/@a.Id">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<dialog class="modal" id="create-sa" @(Model.OpenCreate ? "data-auto-open" : "")>
    <form method="post" asp-page-handler="Create" class="card-body">
        <h3>New service account</h3>
        <p class="small">One account per agent or automation, so each can be limited, rotated and revoked on its own. The first key is issued right away.</p>
        <div class="form-row two">
            <div class="field">
                <label for="sa-name">Name</label>
                <input class="input" id="sa-name" name="name" placeholder="claude-code" maxlength="80" required />
            </div>
            <div class="field">
                <label for="sa-desc">Description <span class="muted">(optional)</span></label>
                <input class="input" id="sa-desc" name="description" placeholder="Build reports from my laptop" maxlength="300" />
            </div>
        </div>
        <div class="field">
            <label>Permissions</label>
            <div class="checks">
                @foreach (var s in ServiceScopes.All)
                {
                    <label class="check"><input type="checkbox" name="scopes" value="@s" @(s == ServiceScopes.Publish ? "checked" : "") /> <span><code>@s</code> <span class="muted">— @ServiceScopes.Descriptions[s]</span></span></label>
                }
            </div>
            <p class="hint">Start with <strong>publish</strong> only. Add <strong>read</strong> permissions only when the agent must look at notifications other publishers wrote.</p>
        </div>
        <div class="field">
            <label for="sa-type">What is it?</label>
            <select class="input" id="sa-type" name="publisherType">
                @foreach (var t in PublisherTypes.Declarable) { <option value="@t">@PublisherTypes.Labels[t]</option> }
            </select>
            <p class="hint">Recorded on every notification this account publishes, next to its name. Connecting over MCP does not make something an AI agent; say so here if it is one.</p>
        </div>
        <div class="form-row two">
            <div class="field">
                <label for="sa-tags">Allowed hashtags</label>
                <input class="input mono" id="sa-tags" name="allowedTags" value="@ServiceAccountService.DefaultAllowedTags" placeholder="agent-* ci/*" required />
                <p class="hint">Patterns separated by spaces or commas; <code>*</code> matches anything. A publish to any other hashtag is refused and logged.</p>
            </div>
            <div class="field">
                <label for="sa-hosts">Allowed link hosts <span class="muted">(optional)</span></label>
                <input class="input mono" id="sa-hosts" name="allowedUrlHosts" placeholder="github.com status.example.com" />
                <p class="hint">Links must be https. Leave empty to allow any https host.</p>
            </div>
        </div>
        <div class="form-row two">
            <div class="field">
                <label for="sa-limit">Publishes per hour</label>
                <select class="input" id="sa-limit" name="hourlyLimit">
                    <option value="20">20</option>
                    <option value="60" selected>60</option>
                    <option value="200">200</option>
                    <option value="1000">1000</option>
                </select>
            </div>
            <div class="field">
                <label for="sa-expires">First key expires</label>
                <select class="input" id="sa-expires" name="expiresDays">
                    <option value="0">Never</option>
                    <option value="30">In 30 days</option>
                    <option value="90" selected>In 90 days</option>
                    <option value="365">In 1 year</option>
                </select>
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" data-close>Cancel</button>
            <button type="submit" class="btn btn-primary">Create and issue key</button>
        </div>
    </form>
</dialog>
