@page "/dashboard/service-accounts/{id:guid}"
@using HashRelay.Contracts
@model HashRelay.Server.Pages.Dashboard.ServiceAccountModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.Account.Name;
    var a = Model.Account;
    var mcpJson = "{\n  \"mcpServers\": {\n    \"hashrelay\": {\n      \"url\": \"" + Model.McpUrl + "\",\n      \"headers\": { \"Authorization\": \"Bearer " + (Model.NewSecret ?? "hr_svc_…") + "\" }\n    }\n  }\n}";
}
<div class="page-head">
    <div>
        <p class="small muted" style="margin:0 0 .25rem"><a href="/dashboard/service-accounts">Service accounts</a> /</p>
        <h1 style="display:flex;align-items:center;gap:.6rem">@a.Name @if (a.Enabled) { <span class="badge badge-success"><span class="dot"></span>Enabled</span> } else { <span class="badge badge-danger">Disabled</span> }</h1>
        <p>@(string.IsNullOrEmpty(a.Description) ? "Service account for AI agents and automations." : a.Description)</p>
    </div>
    <div class="page-actions">
        @if (Model.CanManage)
        {
            <button class="btn btn-primary" data-open="#issue-key">New key</button>
            @if (Model.ConnectedClient is not null && a.Enabled)
            {
                <form method="post" asp-page-handler="Disconnect" onsubmit="return confirm('Disconnect @Model.ConnectedClient.Name? Every token it holds stops working immediately.')">
                    <button type="submit" class="btn btn-danger">Disconnect app</button>
                </form>
            }
            <form method="post" asp-page-handler="Enable" onsubmit="return confirm('@(a.Enabled ? "Disable this service account? Every key stops working immediately." : "Enable this service account?")')">
                <input type="hidden" name="enabled" value="@(a.Enabled ? "false" : "true")" />
                <button type="submit" class="btn @(a.Enabled ? "btn-danger" : "")">@(a.Enabled ? "Disable" : "Enable")</button>
            </form>
        }
    </div>
</div>
<partial name="_Flash" />

@if (Model.ConnectedClient is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="flex mb-1"><span class="badge badge-accent">Connected app</span><strong>@Model.ConnectedClient.Name</strong>@if (Model.ConnectedClient.ClientUri is not null) { <span class="small muted">@Model.ConnectedClient.ClientUri</span> }</div>
            <p class="small">This service account was created when @Model.ConnectedClient.Name connected through OAuth. It holds short-lived tokens that refresh automatically, so there is no key to copy; changing the policy below applies on its next request, and <strong>Disconnect app</strong> revokes everything at once.</p>
        </div>
    </div>
}

@if (Model.NewSecret is not null)
{
    <div class="card mb-3" style="border-color: color-mix(in srgb, var(--success) 45%, transparent)">
        <div class="card-body">
            <div class="flex mb-1"><span class="badge badge-success">New key</span><strong>@Model.NewLabel</strong></div>
            <p class="small">Copy this key now. For your security it is shown once and only a hash is stored.</p>
            <div class="secret-box"><code id="new-secret">@Model.NewSecret</code><button class="btn btn-sm" data-copy="#new-secret">Copy</button></div>
        </div>
    </div>
}

<div class="grid" style="grid-template-columns: 1.25fr .75fr; gap: 1rem; align-items: start">
    <div class="card">
        <div class="card-body">
            <h3 style="margin-top:0">Connect an agent</h3>
            <p class="small">The MCP endpoint is <code>@Model.McpUrl</code>. Authenticate with a key of this account as a bearer token; the agent then gets the tools <code>publish_notification</code>, <code>list_tags</code> and, depending on permissions, <code>list_notifications</code>, <code>get_notification</code>, <code>list_endpoints</code> and <code>set_subscriptions</code>.</p>
            <div class="code-title">Claude Code</div>
            <div class="code wrap"><button class="copy" data-copy>Copy</button><pre><code>claude mcp add --transport http hashrelay @Model.McpUrl \
  --header "Authorization: Bearer @(Model.NewSecret ?? "hr_svc_…")"</code></pre></div>
            <div class="code-title mt-2">Cursor, VS Code, Windsurf (mcp.json)</div>
            <div class="code wrap"><button class="copy" data-copy>Copy</button><pre><code>@mcpJson</code></pre></div>
            <div class="code-title mt-2">REST (same key)</div>
            <div class="code wrap"><button class="copy" data-copy>Copy</button><pre><code>curl -X POST @Model.PublicUrl/api/v1/notifications \
  -H "Authorization: Bearer @(Model.NewSecret ?? "hr_svc_…")" \
  -H "Content-Type: application/json" \
  -d '{"tags":["@(a.AllowedTagList.FirstOrDefault()?.Replace("*", "report") ?? "agent-report")"],"title":"Hello from an agent"}'</code></pre></div>
        </div>
    </div>

    <div class="card">
        <form method="post" asp-page-handler="Update" class="card-body">
            <h3 style="margin-top:0">Policy</h3>
            <div class="field">
                <label for="name">Name</label>
                <input class="input" id="name" name="name" value="@a.Name" maxlength="80" required @(Model.CanManage ? "" : "disabled") />
            </div>
            <div class="field">
                <label for="description">Description</label>
                <input class="input" id="description" name="description" value="@a.Description" maxlength="300" @(Model.CanManage ? "" : "disabled") />
            </div>
            <div class="field">
                <label>Permissions</label>
                <div class="checks">
                    @foreach (var s in ServiceScopes.All)
                    {
                        <label class="check"><input type="checkbox" name="scopes" value="@s" @(a.ScopeList.Contains(s) ? "checked" : "") @(Model.CanManage ? "" : "disabled") /> <span><code>@s</code></span></label>
                    }
                </div>
            </div>
            <div class="field">
                <label for="allowedTags">Allowed hashtags</label>
                <input class="input mono" id="allowedTags" name="allowedTags" value="@string.Join(" ", a.AllowedTagList)" required @(Model.CanManage ? "" : "disabled") />
                <p class="hint">Space or comma separated patterns; <code>*</code> matches anything.</p>
            </div>
            <div class="field">
                <label for="allowedUrlHosts">Allowed link hosts</label>
                <input class="input mono" id="allowedUrlHosts" name="allowedUrlHosts" value="@string.Join(" ", a.AllowedUrlHostList)" placeholder="any https host" @(Model.CanManage ? "" : "disabled") />
            </div>
            <div class="field">
                <label for="hourlyLimit">Publishes per hour</label>
                <input class="input" id="hourlyLimit" name="hourlyLimit" type="number" min="1" max="10000" value="@a.HourlyPublishLimit" @(Model.CanManage ? "" : "disabled") />
            </div>
            @if (Model.CanManage)
            {
                <div class="modal-actions" style="justify-content:flex-start"><button type="submit" class="btn btn-primary">Save policy</button></div>
            }
        </form>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body" style="padding-bottom:0"><h3 style="margin:0">Keys</h3></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Label</th><th>Key</th><th>Created</th><th>Expires</th><th>Last used</th><th>Status</th><th class="actions"></th></tr></thead>
            <tbody>
                @if (Model.Keys.Count == 0)
                {
                    <tr><td colspan="7" class="muted">No keys. Issue one with “New key”.</td></tr>
                }
                @foreach (var k in Model.Keys)
                {
                    var active = k.IsActive(Model.Now);
                    <tr>
                        <td><strong>@k.Label</strong></td>
                        <td class="mono small">@k.Hint</td>
                        <td><time data-rel datetime="@k.CreatedAt.ToString("o")">@k.CreatedAt.ToString("d")</time></td>
                        <td>@if (k.ExpiresAt is null) { <span class="muted">never</span> } else { <time data-rel datetime="@k.ExpiresAt.Value.ToString("o")">@k.ExpiresAt.Value.ToString("d")</time> }</td>
                        <td>@if (k.LastUsedAt is null) { <span class="muted">never</span> } else { <time data-rel datetime="@k.LastUsedAt.Value.ToString("o")">@k.LastUsedAt.Value.ToString("g")</time> }</td>
                        <td>@if (k.RevokedAt is not null) { <span class="badge badge-danger">Revoked</span> } else if (!active) { <span class="badge badge-danger">Expired</span> } else if (!a.Enabled) { <span class="badge">Suspended</span> } else { <span class="badge badge-success"><span class="dot"></span>Active</span> }</td>
                        <td class="actions">
                            @if (active && Model.CanManage)
                            {
                                <form method="post" asp-page-handler="Revoke" onsubmit="return confirm('Revoke this key? Anything using it will stop working immediately.')">
                                    <input type="hidden" name="credentialId" value="@k.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Revoke</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body" style="padding-bottom:0"><h3 style="margin:0">Activity</h3><p class="small muted">The last 50 events for this account: publishes, refusals, key changes.</p></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>When</th><th>Event</th><th>Target</th><th>Detail</th><th>Via</th></tr></thead>
            <tbody>
                @if (Model.Activity.Count == 0)
                {
                    <tr><td colspan="5" class="muted">Nothing yet.</td></tr>
                }
                @foreach (var e in Model.Activity)
                {
                    <tr>
                        <td><time data-rel datetime="@e.At.ToString("o")">@e.At.ToString("g")</time></td>
                        <td><span class="badge @ServiceAccountModel.ActionBadge(e.Action)">@ServiceAccountModel.ActionLabel(e.Action)</span></td>
                        <td class="mono small">@e.Target</td>
                        <td class="small" style="white-space:normal">@e.Detail</td>
                        <td class="small muted">@e.Source</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<dialog class="modal" id="issue-key">
    <form method="post" asp-page-handler="IssueKey" class="card-body">
        <h3>New key for @a.Name</h3>
        <p class="small">Issue a second key to rotate: hand the new one to the agent, then revoke the old one.</p>
        <div class="field">
            <label for="key-label">Label</label>
            <input class="input" id="key-label" name="label" placeholder="@a.Name · laptop" maxlength="80" />
        </div>
        <div class="field">
            <label for="key-expires">Expires</label>
            <select class="input" id="key-expires" name="expiresDays">
                <option value="0">Never</option>
                <option value="30">In 30 days</option>
                <option value="90" selected>In 90 days</option>
                <option value="365">In 1 year</option>
            </select>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" data-close>Cancel</button>
            <button type="submit" class="btn btn-primary">Issue key</button>
        </div>
    </form>
</dialog>
