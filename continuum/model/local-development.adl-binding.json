      {
        "kind": "Binding",
        "id": "63636363-6363-4363-8363-636363636363",
        "name": "B12",
        "description": "Deployable ::HashRelay.DesktopAgent — REALISED in M1 (src/HashRelay.Agent, installer/HashRelay.iss). Gaps against M2 requirements are named in configuration.",
        "attributes": {
          "vocabulary": "avlon.hashrelay.bindings.windows",
          "technology": "windows-tray-agent",
          "configuration": {
            "runtime": "net10.0-windows10.0.19041.0, self-contained win-x64",
            "ui": "WinForms tray icon and pairing form",
            "notifications": "Windows toast API (Microsoft.Toolkit.Uwp.Notifications), unpackaged registration, AUMID Avlon.HashRelay",
            "distribution": "per-user Inno Setup EXE (installer/HashRelay.iss), no elevation",
            "signing": "Azure Artifact Signing via build/sign.ps1 (build.ps1 -Sign)",
            "startAtLogin": "HKCU Software/Microsoft/Windows/CurrentVersion/Run value HashRelay",
            "update": "GAP vs VerifiedUpdates: no in-agent updater; a newer installer is re-run by hand (D-M2-07)",
            "uninstall": "GAP vs PerUserLifecycle: stops agent, removes Run key and toast registration, but leaves %APPDATA%/HashRelay credential and grant and revokes nothing (D-M2-09)",
            "diagnostics": "GAP vs AgentDiagnostics: logs under %APPDATA%/HashRelay/logs; no status report or export bundle yet"
          }
        },
        "relationships": {
          "binds": {
            "ref": "20202020-2020-4020-8020-202020202020",
            "hint": "HashRelay.DesktopAgent"
          }
        }
