subscription_id         = "00000000-0000-0000-0000-000000000000"
name_prefix             = "hashrelaymyunique"
environment             = "dev"
location                = "canadacentral"
container_cpu           = 0.25
container_memory        = "0.5Gi"
allow_signup            = true
# Optional custom domain in an Azure DNS zone you own:
dns_zone_name           = ""
dns_zone_resource_group = ""
dns_record_name         = "hashrelay"

